# ===== LLM 配置 =====
# LLM 提供商: qwen (百炼 OpenAI 兼容) 或 dashscope (DashScope SDK)
LLM_PROVIDER=qwen

# 千问百炼 API Key (OpenAI 兼容模式 + DashScope 共用同一 Key)
QWEN_API_KEY=your_qwen_api_key
QWEN_API_BASE=https://your-bailian-endpoint/compatible-mode/v1
QWEN_LLM_MODEL=qwen-plus

# DashScope API Key (与 QWEN_API_KEY 可共用)
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_API_BASE=https://your-bailian-endpoint/api/v1

# 商汤科技 SenseNova API Key (LLM、图片生成)
SENSENOVA_API_KEY=your_sensenova_api_key
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1

# 可灵AI API Key (视频生成)
KLING_ACCESS_KEY=your_kling_access_key
KLING_SECRET_KEY=your_kling_secret_key

# ===== LangSmith 追踪配置 (可选) =====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langchain_api_key
LANGCHAIN_PROJECT=multi-agent-ecommerce-shopping-assistant

# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8002
DEBUG=true

# ===== 存储配置 =====
STORAGE_TYPE=local
STORAGE_PATH=./output

# ===== 日志配置 =====
LOG_LEVEL=INFO

# ===== PostgreSQL 配置 =====
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=cbcf

# ===== Redis 配置 =====
REDIS_URL=redis://localhost:6379/0

# ===== RAG 配置 =====
RAG_ENABLED=true
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=BAAI/bge-large-zh
EMBEDDING_DEVICE=cpu
VECTOR_DIMENSION=1024
CHUNK_SIZE=512
CHUNK_OVERLAP=64
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.5

# ===== RAG 高级配置 =====
# Query 改写
RAG_QUERY_REWRITING_ENABLED=false
RAG_QUERY_REWRITING_MODE=single
RAG_QUERY_REWRITING_MAX_VARIANTS=3
RAG_HYDE_ENABLED=false

# Cross-Encoder 重排序
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANKER_TOP_K=5
RAG_RERANKER_DEVICE=auto

# 混合检索 (Dense+Sparse+ColBERT)
RAG_HYBRID_RETRIEVAL_ENABLED=false
RAG_HYBRID_MODEL=BAAI/bge-m3
RAG_HYBRID_DENSE_WEIGHT=0.4
RAG_HYBRID_SPARSE_WEIGHT=0.3
RAG_HYBRID_COLBERT_WEIGHT=0.3
RAG_HYBRID_RRF_K=60

# ===== Mock 资产降级 =====
ALLOW_MOCK_ASSETS=true

# ===== 消费者侧能力（虚拟买手团 / 售后仲裁庭 / 直播购物分身） =====
CONSUMER_FEATURES_ENABLED=true

# 全网比价数据源: auto(es→crawler→mock) / es / crawler / mock
PRICE_SEARCH_BACKEND=auto
PRICE_SEARCH_TIMEOUT_SECONDS=8
PRICE_HISTORY_DAYS=90
# 允许在未配置 ES/采集服务时降级为模拟比价数据（产物标记 is_mock=True）
ALLOW_MOCK_SOURCES=true

# Elasticsearch 价格索引（可选，配置后 auto 优先走 ES）
ELASTICSEARCH_URL=
ELASTICSEARCH_INDEX=product_prices
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

# 独立采集服务（可选，本项目只定义调用契约，不内置爬虫）
PRICE_CRAWLER_ENDPOINT=
PRICE_CRAWLER_API_KEY=

# 买手决策卡评分权重（自动归一化）
BUYER_WEIGHT_STYLE=0.3
BUYER_WEIGHT_VALUE=0.4
BUYER_WEIGHT_QUALITY=0.3
BUYER_STRONG_BUY_THRESHOLD=85
BUYER_BUY_THRESHOLD=72
BUYER_CONSIDER_THRESHOLD=60

# 直播分身
LIVE_DANMAKU_WINDOW_SECONDS=120
LIVE_PRICE_ALERT_THRESHOLD=0.15
LIVE_MAX_KEY_POINTS=20

# 纠纷仲裁时效窗口（天）
DISPUTE_SEVEN_DAY_RETURN_DAYS=7
DISPUTE_QUALITY_RETURN_DAYS=15

# ===== 认证配置 =====
AUTH_ENABLED=false
# 凭证加密密钥: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=your_fernet_key_here
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
